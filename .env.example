# ───────────── Database (Postgres / Neon) ─────────────
# DATABASE_URL = pooled (insert `-pooler` into the Neon host) — used at runtime.
# DIRECT_URL   = non-pooled — used only by `prisma migrate`.
# On localhost a single Node process is fine with either URL for both vars.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth — generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: Sign in with Google (Google Cloud Console → OAuth 2.0 Client IDs)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: encrypt broker API secrets in production
# BROKER_ENCRYPTION_KEY=

# Tradovate OAuth (hosted login — redirect URI must match Tradovate app settings exactly)
# TRADOVATE_OAUTH_REDIRECT_URI=http://localhost:3000/api/brokers/tradovate/oauth/callback
# TRADOVATE_OAUTH_STATE_SECRET=   # optional; defaults to NEXTAUTH_SECRET
TRADOVATE_OAUTH_CLIENT_ID=
TRADOVATE_OAUTH_CLIENT_SECRET=

# Weekly roundup email delivery (required to actually send emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TradeXEssence <no-reply@tradexessence.com>"

# Protect cron endpoints (weekly roundup + broker auto-sync)
# Broker auto-sync: POST or GET /api/cron/broker-sync with header Authorization: Bearer <CRON_SECRET> or x-cron-secret
CRON_SECRET=

# Optional: IANA timezone for P&L calendar + "day of week" chart bucketing when the server has no browser hint.
# The dashboard sends your device zone as ?tz=… automatically; this env overrides both.
# TRADE_STATS_TZ=Europe/London

# Optional: AI “organize dictation into bullets” in the journal notes editor (toolbar sparkles + mic)
# Put the real key in .env.local (never commit it). Next.js does NOT load .env.example at runtime.
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
# GEMINI_DICTATION_MODEL=gemini-2.0-flash
# GOOGLE_GENERATIVE_AI_API_KEY=   # optional alias; same as GEMINI_API_KEY
GEMINI_API_KEY=
